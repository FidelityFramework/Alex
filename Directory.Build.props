<Project>
  <PropertyGroup>
    <!-- The published PSG contract. It is its own project; the compiler service produces revisions of it. -->
    <PsgContractProject>$(MSBuildThisFileDirectory)../Fidelity.PSG/src/Fidelity.PSG/Fidelity.PSG.fsproj</PsgContractProject>
    <!-- The library the contract references. It reaches Alex through the contract. -->
    <PsgContractLibrary>$(MSBuildThisFileDirectory)../BAREWire/src/BAREWire.fsproj</PsgContractLibrary>
  </PropertyGroup>
  <!-- Optional local checkout selection; overrides default paths when present while remaining local to the project. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />
</Project>
