<Project>
  <!--
    The boundary of Alex, enforced before every compile of the library and of its tests.

    ALEX001  A source names the compiler service. Alex receives a published PSG revision
             and nothing else; a fact it lacks is missing from the revision.
    ALEX002  The project references something other than the published contract, the
             library the contract references, and, for the tests, Alex itself.
    ALEX003  A source of the library rewrites emitted MLIR, starts a process, or loads a
             plugin. The tests start the MLIR verifier and are exempt from the process rule.
    ALEX004  A library emission spells an LLVM dialect type or operation. Target
             realization belongs to the selected backend, never the middle end.
  -->
  <PropertyGroup>
    <_AlexBoundaryTaskProject>$(MSBuildThisFileDirectory)Alex.Boundary.Tasks/Alex.Boundary.Tasks.csproj</_AlexBoundaryTaskProject>
    <_AlexBoundaryTaskAssembly>$(MSBuildThisFileDirectory)Alex.Boundary.Tasks/bin/Debug/net10.0/Alex.Boundary.Tasks.dll</_AlexBoundaryTaskAssembly>
    <AlexBoundaryScope Condition="'$(AlexBoundaryScope)' == ''">library</AlexBoundaryScope>
    <AlexBoundaryPermitted>$(PsgContractProject);$(PsgContractLibrary);$(AlexBoundaryAlsoPermitted)</AlexBoundaryPermitted>
  </PropertyGroup>
  <UsingTask TaskName="Alex.Boundary.Tasks.ValidateAlexBoundary"
             AssemblyFile="$(_AlexBoundaryTaskAssembly)"
             TaskFactory="TaskHostFactory" />
  <Target Name="BuildAlexBoundaryTask"
          BeforeTargets="CheckAlexBoundary"
          Condition="'$(SkipCompilerExecution)' != 'true'">
    <MSBuild Projects="$(_AlexBoundaryTaskProject)"
             Targets="Restore"
             Properties="Configuration=Debug;Platform=AnyCPU"
             Condition="!Exists('$(MSBuildThisFileDirectory)Alex.Boundary.Tasks/obj/project.assets.json')" />
    <MSBuild Projects="$(_AlexBoundaryTaskProject)"
             Targets="Build"
             Properties="Configuration=Debug;Platform=AnyCPU;BuildProjectReferences=false" />
  </Target>
  <Target Name="CheckAlexBoundary"
          BeforeTargets="CoreCompile"
          Condition="'$(SkipCompilerExecution)' != 'true'">
    <ValidateAlexBoundary Sources="@(Compile)"
                          ProjectReferences="@(ProjectReference)"
                          Permitted="$(AlexBoundaryPermitted)"
                          Scope="$(AlexBoundaryScope)" />
  </Target>
  <Target Name="RunAlexBoundaryAnalyzer"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(AlexBoundaryScope)' == 'library'">
    <PropertyGroup>
      <_AlexAnalyzersDir>$(MSBuildThisFileDirectory)../tools/Alex.Analyzers</_AlexAnalyzersDir>
    </PropertyGroup>
    <Exec WorkingDirectory="$(_AlexAnalyzersDir)"
          Command="dotnet tool restore &amp;&amp; dotnet build &quot;$(_AlexAnalyzersDir)/Alex.Analyzers.fsproj&quot; --nologo -v:q &amp;&amp; dotnet fsharp-analyzers --project &quot;$(MSBuildProjectFullPath)&quot; --analyzers-path &quot;$(_AlexAnalyzersDir)/bin/Debug/net10.0&quot; --include-analyzers &quot;Alex pure-core baseline&quot; &quot;Alex published boundary&quot; --exclude-files &quot;**/obj/**&quot; --fail-on-type-errors" />
  </Target>
</Project>
